# ─── Matematik Arkadaşım — örnek ortam değişkenleri ───────────────────────────
# Vercel'de: Project → Settings → Environment Variables. Yerelde: `.env.local` (Git'e GİTMEZ).
# Anahtarlar YALNIZCA sunucuda kullanılır; tarayıcıya gönderilmez. Bu dosyaya gerçek değer yazmayın.
# Rehber: UCRETSIZ_BULUT_KURULUMU.md

# ══ ÜCRETSİZ BULUT KURULUMU (önerilen: Vercel Hobby + Cloudflare Workers AI) ══════
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Görsel destekli model (Cloudflare'de "Vision: Yes"). Mistral Small 3.1 Cloudflare'de görsel ALMAZ.
CLOUDFLARE_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
# Ücretsiz plan günde 10.000 nöron; uygulama 9.000'de durur (güvenlik payı). 10.000 üstü kabul edilmez.
CLOUDFLARE_DAILY_NEURON_BUDGET=9000

# İsteğe bağlı ÜCRETSİZ yedek: Cloudflare'in günlük kapasitesi dolunca kullanılır (ödeme yöntemi eklemeyin).
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Yalnızca ücretsiz sağlayıcı adları geçerlidir (cloudflare, groq); ücretli adlar yok sayılır.
AI_FALLBACK_PROVIDERS=groq

# Aile PIN'i — internette yayında ZORUNLU (yoksa yapay zekâ çalışmaz)
APP_ACCESS_PIN=
# En az 32 karakterlik rastgele değer (ör. parola yöneticisiyle üretilmiş 40 karakter)
APP_SESSION_SECRET=

# Kalıcı sayaç deposu — Vercel'de ZORUNLU. Vercel → Storage → Upstash for Redis (Free) bağlanınca
# KV_REST_API_URL / KV_REST_API_TOKEN kendiliğinden eklenir; elle girecekseniz:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Ücretli yapay zekâ KAPALI: 1 yapılmadıkça ücretli servis asla kullanılmaz ve asla yedek olmaz.
ALLOW_PAID_AI=0
# Soru sınırı YOK. Yalnızca kötüye kullanım koruması: dakikada en fazla 20 istek.
RATE_LIMIT_PER_MINUTE=20
# Basit işlem/denklemler ve kurallı alıştırmalar yapay zekâsız çözülür (0 = kapat)
LOCAL_SOLVER_FIRST=1
# Fotoğraf boyutu (MB). Vercel'de 3'ü geçmeyin (istek gövdesi sınırı ~4,5 MB).
MAX_IMAGE_MB=3

# ══ ALTERNATİF: EVDEKİ BİLGİSAYAR (EV_KURULUMU.md) ══════════════════════════
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_NUM_CTX=8192
# AI_MAX_WAITING=2
# DATA_DIR=.data

# ══ İSTEĞE BAĞLI ÜCRETLİ SAĞLAYICILAR (önerilmez; ALLOW_PAID_AI=1 gerekir) ══════
# ── Anthropic Claude ──
ANTHROPIC_API_KEY=
# Model seçenekleri (yaklaşık fiyat, 1 milyon jeton giriş/çıkış, USD):
#   claude-haiku-5-5   0,10 / 0,50  → en ucuz, en hızlı
#   claude-sonnet-5-5  2 / 10       → önerilen denge (varsayılan)
#   claude-opus-5-5    4 / 20       → en yüksek doğruluk, en pahalı
ANTHROPIC_MODEL=claude-sonnet-5-5
# Cevap kontrolü ve ipucu gibi basit görevler için ucuz model
ANTHROPIC_LIGHT_MODEL=claude-haiku-5-5
# Düşünme derinliği: low | medium | high (düşük = daha ucuz ve hızlı)
ANTHROPIC_EFFORT=medium

# ── OpenAI (AI_PROVIDER=openai ise) ──
OPENAI_API_KEY=
# Hesabınızda erişiminiz olan bir görsel destekli model adı yazın (bu kurulumda doğrulanmadı)
OPENAI_MODEL=gpt-4.1
OPENAI_LIGHT_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Fiyat tablosunda olmayan modeller için günlük bütçe hesabında kullanılacak fiyat (USD / 1M jeton)
# MODEL_PRICE_INPUT=
# MODEL_PRICE_OUTPUT=

# ── İsteğe bağlı doğal ses (sunucu TTS): none | openai ──
TTS_PROVIDER=none
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE_FEMALE=nova
OPENAI_TTS_VOICE_MALE=onyx

# Ücretli sağlayıcılarda günlük yaklaşık harcama sınırı (USD)
DAILY_BUDGET_USD=1

# ── YALNIZCA OTOMATİK TESTLER İÇİN — yayında ASLA açmayın ──
# AI_PROVIDER=mock ve ALLOW_MOCK_PROVIDER=1 birlikte verilirse sahte test sağlayıcısı kullanılır.
# ALLOW_MOCK_PROVIDER=
