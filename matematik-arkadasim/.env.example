# ─── Matematik Arkadaşım — örnek ortam değişkenleri ───────────────────────────
# Bu dosyayı `.env.local` adıyla kopyalayın ve değerleri doldurun.
# API anahtarları YALNIZCA sunucuda kullanılır; tarayıcıya asla gönderilmez.
# Hiçbir anahtar girilmezse uygulama açıkça etiketlenmiş DEMO MODUNDA çalışır.

# Yapay zekâ sağlayıcısı: anthropic | openai | demo
AI_PROVIDER=anthropic

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Düşünme derinliği: low | medium | high | xhigh | max (düşük = daha ucuz/hızlı)
ANTHROPIC_EFFORT=medium

# OpenAI (AI_PROVIDER=openai ise)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1

# İsteğe bağlı sunucu tarafı seslendirme (TTS): none | openai
TTS_PROVIDER=none
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE_FEMALE=nova
OPENAI_TTS_VOICE_MALE=onyx

# Maliyet ve kötüye kullanım koruması
# Bir istemcinin (IP) dakikada yapabileceği yapay zekâ isteği
RATE_LIMIT_PER_MINUTE=10
# Bir istemcinin günlük yapay zekâ isteği sınırı
DAILY_LIMIT_PER_CLIENT=60
# Tüm uygulama için günlük toplam yapay zekâ isteği sınırı (0 = sınırsız)
DAILY_LIMIT_GLOBAL=2000
# Yüklenebilecek en büyük görsel (MB, sıkıştırma sonrası)
MAX_IMAGE_MB=4
