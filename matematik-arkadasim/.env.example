# ─── Matematik Arkadaşım — örnek ortam değişkenleri ───────────────────────────
# Kolay yol: `npm run kurulum` sihirbazı `.env.local` dosyasını sizin için yazar.
# Elle: bu dosyayı `.env.local` adıyla kopyalayın (.env.local Git'e GİTMEZ).
# Varsayılan kurulum ÜCRETSİZDİR: yapay zekâ evdeki bilgisayarda Ollama ile çalışır,
# hiçbir veri başka bir şirketin sunucusuna gönderilmez.

# ══ ÜCRETSİZ EV KURULUMU (önerilen) ══════════════════════════════════════════
AI_PROVIDER=ollama
# Ollama yalnızca bu bilgisayarda dinler; internete AÇMAYIN.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 8 GB RAM: gemma3:4b (≈3,4 GB).  16 GB+ RAM: gemma4:e4b
OLLAMA_MODEL=gemma3:4b
# Bağlam penceresi (jeton). 8 GB RAM için 8192; bellek yetmezse 4096 deneyin.
OLLAMA_NUM_CTX=8192
# Aynı anda tek yapay zekâ isteği çalışır; sırada en fazla bu kadar istek bekler (fazlası "meşgul" uyarısı alır)
AI_MAX_WAITING=2
# Ücretli yapay zekâ KAPALI. 1 yapılmadıkça ücretli servis asla kullanılmaz ve hiçbir zaman yedek olarak devreye girmez.
ALLOW_PAID_AI=0
# Günlük soru sınırı (0 = sınırsız). Ebeveyn Ayarlar ekranından PARENT_PIN ile değiştirebilir.
DAILY_QUESTION_LIMIT=10
PARENT_PIN=
APP_TIMEZONE=Europe/Istanbul
# Sayaçlar ve cihazlar arası eşitleme kopyası bu klasörde (bilgisayarda) tutulur
DATA_DIR=.data

# ══ İSTEĞE BAĞLI ÜCRETLİ SAĞLAYICILAR (önerilmez; ALLOW_PAID_AI=1 gerekir) ══════
# ── Anthropic Claude ──
ANTHROPIC_API_KEY=
# Model seçenekleri (yaklaşık fiyat, 1 milyon jeton giriş/çıkış, USD):
#   claude-haiku-5-5   0,10 / 0,50  → en ucuz, en hızlı
#   claude-sonnet-5-5  2 / 10       → önerilen denge (varsayılan)
#   claude-opus-5-5    4 / 20       → en yüksek doğruluk, en pahalı
ANTHROPIC_MODEL=claude-sonnet-5-5
# Cevap kontrolü ve ipucu gibi basit görevler için ucuz model
ANTHROPIC_LIGHT_MODEL=claude-haiku-5-5
# Düşünme derinliği: low | medium | high (düşük = daha ucuz ve hızlı)
ANTHROPIC_EFFORT=medium

# ── OpenAI (AI_PROVIDER=openai ise) ──
OPENAI_API_KEY=
# Hesabınızda erişiminiz olan bir görsel destekli model adı yazın (bu kurulumda doğrulanmadı)
OPENAI_MODEL=gpt-4.1
OPENAI_LIGHT_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Fiyat tablosunda olmayan modeller için günlük bütçe hesabında kullanılacak fiyat (USD / 1M jeton)
# MODEL_PRICE_INPUT=
# MODEL_PRICE_OUTPUT=

# ── İsteğe bağlı doğal ses (sunucu TTS): none | openai ──
TTS_PROVIDER=none
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE_FEMALE=nova
OPENAI_TTS_VOICE_MALE=onyx

# ── Erişim kontrolü (İNTERNETTE YAYINLIYORSANIZ ÖNERİLİR) ──
# Tanımlanırsa yapay zekâ özellikleri için aile PIN'i istenir (defter ve konular PIN'siz açılır).
APP_ACCESS_PIN=
# PIN tanımlıysa ZORUNLU: en az 32 karakterlik rastgele bir değer.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET=

# ── Maliyet ve kötüye kullanım koruması ──
# Oturum başına dakikalık yapay zekâ isteği (IP başına bunun 3 katı)
RATE_LIMIT_PER_MINUTE=8
# Oturum başına günlük yapay zekâ isteği (IP başına bunun 3 katı)
DAILY_LIMIT_PER_CLIENT=40
# Tüm uygulama için günlük toplam yapay zekâ isteği (0 = sınırsız)
DAILY_LIMIT_GLOBAL=300
# Günlük yaklaşık yapay zekâ harcama sınırı (USD). Aşılınca o gün yeni çözüm yapılmaz.
DAILY_BUDGET_USD=2
# Yüklenebilecek en büyük görsel (MB). Vercel'de 3'ü geçmeyin (istek gövdesi sınırı ~4,5 MB).
MAX_IMAGE_MB=3

# ── Kalıcı kota deposu (Vercel gibi sunucusuz ortamlarda ŞİDDETLE önerilir) ──
# Upstash Redis (ücretsiz katman yeterli). Tanımlı değilse sayaçlar bellekte tutulur ve
# sunucusuz ortamda her örnek ayrı saydığı için limitler güvenilir olmaz.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── YALNIZCA OTOMATİK TESTLER İÇİN — yayında ASLA açmayın ──
# AI_PROVIDER=mock ve ALLOW_MOCK_PROVIDER=1 birlikte verilirse sahte test sağlayıcısı kullanılır.
# ALLOW_MOCK_PROVIDER=
