{
  "name": "matematik-arkadasim",
  "version": "0.1.0",
  "private": true,
  "description": "Matematik Arkadaşım — 7. sınıf öğrencileri için yapay zekâ destekli, sesli ve görsel matematik öğretmeni",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/smoke.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "eval:ai": "RUN_AI_EVAL=1 vitest run tests/ai-eval.test.ts --silent=false",
    "audit": "npm audit --omit=dev && npm audit"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.13.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.2.5",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "idb": "8.0.4",
    "katex": "0.19.1",
    "lucide-react": "0.544.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "2.6.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.7.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "6.2.8",
    "playwright": "1.63.0",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
